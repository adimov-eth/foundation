{
  "name": "@here.build/arrival-ts-lsp",
  "version": "0.1.0",
  "description": "A tsgo-wasm-backed type checker for arrival Scheme, exposed as an MCP DiscoveryTool — (check \"<scm>\") returns type diagnostics positioned on the source (RECONSTRUCTION; not the vscode-LSP mcp-typescript-lsp)",
  "keywords": [
    "arrival",
    "scheme",
    "type-check",
    "mcp",
    "model-context-protocol",
    "tsgo-wasm"
  ],
  "homepage": "https://github.com/here-build/foundation#readme",
  "bugs": {
    "url": "https://github.com/here-build/foundation/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/foundation.git",
    "directory": "arrival/arrival-ts-lsp"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "bin": {
    "arrival-ts-lsp": "./dist/server.js"
  },
  "main": "./dist/check.js",
  "types": "./dist/check.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@here.build/arrival-mcp": "workspace:^",
    "@here.build/arrival-type-lens": "workspace:^",
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
