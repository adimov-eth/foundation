{
  "name": "@here.build/arrival-type-lens",
  "version": "0.1.0",
  "description": "The TypeScript type surface arrival Scheme is checked against — base types + generic per-builtin leaves, plus a consumer-supplied host-function typing contract, checked via the portable tsgo-wasm compiler (RECONSTRUCTION)",
  "keywords": [
    "arrival",
    "scheme",
    "type-lens",
    "typescript",
    "tsgo-wasm",
    "diagnostics"
  ],
  "homepage": "https://github.com/here-build/foundation#readme",
  "bugs": {
    "url": "https://github.com/here-build/foundation/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/here-build/foundation.git",
    "directory": "arrival/arrival-type-lens"
  },
  "license": "FSL-1.1-MIT",
  "author": "here.build",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsc && node ./scripts/copy-prelude.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@here.build/arrival-chain-view": "workspace:^",
    "@here.build/arrival-sweet": "workspace:^",
    "tsgo-wasm": "2026.6.4"
  },
  "devDependencies": {
    "@here.build/eslint-configs": "workspace:^",
    "@here.build/tsconfig": "workspace:^",
    "@types/node": "24.0.0",
    "eslint": "9.39.2",
    "tslib": "2.8.1",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  }
}
